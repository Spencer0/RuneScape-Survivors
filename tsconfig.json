{
    "compilerOptions": {
        "lib": ["ESNext", "DOM", "WebWorker"],
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowJs": true,
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": false,
        "types": ["node"],
        "baseUrl": ".",
        "paths": {
            "#3rdparty/*": ["client/src/3rdparty/*"],
            "#/*": ["client/src/*"]
        }
    },
    "include": ["client/src", "sim/src", "tools"]
}
